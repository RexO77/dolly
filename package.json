{
  "name": "@nischalskanda/dolly",
  "version": "0.1.0",
  "description": "Record a real web product without a cursor, direct a camera over the take, and ship the clip.",
  "keywords": [
    "screen-recording",
    "product-video",
    "case-study",
    "demo",
    "camera",
    "playwright",
    "ffmpeg",
    "cli",
    "studio",
    "cursorless"
  ],
  "license": "MIT",
  "author": "Nischal Skanda",
  "homepage": "https://github.com/RexO77/dolly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RexO77/dolly.git"
  },
  "bugs": {
    "url": "https://github.com/RexO77/dolly/issues"
  },
  "type": "module",
  "exports": {
    ".": "./engine/index.mjs"
  },
  "bin": {
    "dolly": "./bin/dolly.mjs"
  },
  "files": [
    "bin/",
    "cli/",
    "engine/",
    "studio/dist/",
    "templates/",
    "docs/*.md",
    "skill/"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:studio --if-present",
    "prepack": "npm run build",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "check": "npm run lint && npm test",
    "build:studio": "vite build --config studio/vite.config.mjs",
    "dev:studio": "node bin/dolly.mjs storyboard --dev",
    "build:site": "vite build --config site/vite.config.mjs",
    "dev:site": "vite --config site/vite.config.mjs --port 4850",
    "media:site": "node site/scripts/media.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "motion": "^13.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
